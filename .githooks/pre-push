#!/bin/sh
#
# Avisa antes de empujar directo a main. Desde que los repos son publicos, la proteccion de
# rama del servidor ya rechaza ese push; el hook solo lo detecta antes (ver CONTRIBUTING.md).
#
# Se activa por clon, una sola vez:
#   git config core.hooksPath .githooks
#
# Git pasa por stdin una linea por referencia que se empuja:
#   <ref local> <sha local> <ref remota> <sha remota>

RAMA_PROTEGIDA="refs/heads/main"

while read -r _ref_local _sha_local ref_remota _sha_remota; do
    if [ "$ref_remota" = "$RAMA_PROTEGIDA" ]; then
        echo "pre-push: no se empuja directo a main." >&2
        echo "" >&2
        echo "  El trabajo entra por pull request. Para esta rama:" >&2
        echo "    git switch -c m0/lo-que-sea" >&2
        echo "    git push -u origin m0/lo-que-sea" >&2
        echo "" >&2
        echo "  Si de verdad hace falta saltarselo: git push --no-verify" >&2
        exit 1
    fi
done

exit 0
